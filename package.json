{
  "name": "sentinel-torrent",
  "version": "0.1.1",
  "description": "High-performance desktop torrent client",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n ENGINE,VITE,ELECTRON -c green,blue,yellow \"npm run dev:engine\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "cd renderer && npm run dev",
    "dev:engine": "python3 engine/main.py --dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "cd renderer && npm run build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "node scripts/dev-electron.js",
    "electron:build": "npm run package:win",
    "package:linux": "npm run build && node -e \"require('fs').mkdirSync('engine/dist/engine',{recursive:true})\" && electron-builder --linux --publish never",
    "package:win": "npm run build && node -e \"require('fs').mkdirSync('engine/dist/engine',{recursive:true})\" && electron-builder --win --publish never",
    "lint": "cd renderer && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  },
  "author": "Sentinel Contributors <contact@sentinel-torrent.org>",
  "build": {
    "appId": "com.sentinel.torrent",
    "productName": "Sentinel",
    "copyright": "Copyright © 2026 Sentinel Contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "renderer/dist/**"
    ],
    "extraResources": [
      {
        "from": "engine/dist/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "renderer/public/icon.png",
      "maintainer": "Sentinel Contributors <contact@sentinel-torrent.org>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "renderer/public/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Sentinel",
      "fileAssociations": [
        {
          "ext": "torrent",
          "name": "BitTorrent File",
          "description": "BitTorrent Metainfo Document",
          "mimeType": "application/x-bittorrent",
          "role": "Viewer"
        }
      ],
      "protocols": [
        {
          "name": "Magnet URI Scheme",
          "schemes": [
            "magnet"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Sentinel",
      "runAfterFinish": true,
      "uninstallDisplayName": "Sentinel Torrent Downloader",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}